# ═══════════════════════════════════════════════════════════════
# NEXQUANT SUPERBOT V3 — CONFIGURATION (.env.example)
# ═══════════════════════════════════════════════════════════════
# Renommez ce fichier en ".env" et renseignez vos identifiants MT5.
# Le fichier .env est dans .gitignore et ne doit JAMAIS être commité.
# ═══════════════════════════════════════════════════════════════

# ======================
# SÉLECTION DU BROKER
# ======================
BROKER_TYPE=mt5
ALLOW_LIVE_TRADING=false
BACKTEST_MODE=false

# ======================
# IDENTIFIANTS METATRADER 5 (MT5)
# Courtier recommandé: Fusion Markets, IC Markets, etc.
# ======================
MT5_LOGIN=123456
MT5_PASSWORD=votre_mot_de_passe_ici
MT5_SERVER=FusionMarkets-Demo
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# ======================
# UNIVERS D'ACTIFS & HORAIRES
# ======================
# Semaine : 5 Matières premières + 5 Devises majeures
INSTRUMENTS_MT5=EURUSD,GBPUSD,EURGBP,EURJPY,USDJPY,XAUUSD,XAGUSD,XTIUSD,XBRUSD,XNGUSD

# Weekend : 5 Crypto CFDs (Actif uniquement quand Forex/Commodities sont fermés)
MT5_CRYPTO_ENABLED=true
MT5_CRYPTO_SYMBOLS=BTCUSD,ETHUSD,BNBUSD,XRPUSD,SOLUSD

# Timeframe principal & cycle
GRANULARITY=15m
CYCLE_TIME=15

# ======================
# GESTION DU RISQUE V3
# ======================
RISK_PCT=1.0                  # % du capital risqué par trade
MAX_DAILY_LOSS_PCT=2.0        # % perte max par jour (Kill-Switch)
MAX_MONTHLY_LOSS_PCT=5.0      # % perte max par mois
MAX_OPEN_POSITIONS=3          # Nombre max de positions simultanées
MAX_SPREAD_PIPS=2.5           # Spread max toléré à l'entrée
MAX_FOREX_CURRENCY_EXPOSURE=2 # Max positions sur une même devise
KELLY_FRACTION=0.05           # Fraction de dimensionnement Kelly
SL_ATR_MULT=1.5               # Stop Loss standard (× ATR)
TP_ATR_MULT=3.0               # Take Profit standard (× ATR)
TRAIL_ATR_MULT=2.0            # Trailing stop standard
BE_ATR_MULT=1.5               # Break-Even standard
BE_DYN_RR=true                # Break-Even dynamique sur ratio R:R
ENABLE_LOSS_LIMIT=false       # true = applique MAX_DAILY_LOSS_PCT et le blocage des symboles perdants

# ======================
# CONFIGURATION VALIDÉE PAR BACKTEST (étude du 07/10/2026, 3 ans H1 broker)
# Murphy seule, H1, SL 2 / TP 4 ATR, sorties de la stratégie : PF ≈ 1,6 (train) / 1,86 (test).
# Pour l'activer : GRANULARITY=1h, SL_ATR_MULT=2.0, TP_ATR_MULT=4.0, RISK_PCT=0.25 à 0.5,
# ENABLE_LOSS_LIMIT=true, MT5_CRYPTO_ENABLED=false (non testé sur crypto) et les options ci-dessous.
# ======================
ENABLED_STRATEGIES=           # vide = toutes ; ex. MURPHY_TREND
USE_STRATEGY_SL_TP=false      # true = SL/TP de la stratégie (comme le backtest) au lieu du SL/TP ATR × régime
SIGNAL_ON_CLOSED_BAR=false    # true = signal sur bougie clôturée, une fois par bougie (comme le backtest)
MURPHY_MIN_ADX=20             # ADX minimum de Murphy ; 25 recommandé (PF 1,70 / 1,94, gain total conservé)

# ======================
# STRATÉGIES & INDICATEURS
# ======================
SCORE_MIN=6                   # Score minimum de validation d'un signal
EMA_FAST=9                    # EMA rapide globale
EMA_SLOW=21                   # EMA lente globale
EMA_TREND=200                 # EMA de tendance long terme
HTF_EMA=50                    # EMA timeframe supérieur (H4)
D1_EMA=50                     # EMA journalier (D1)
W1_EMA=20                     # EMA hebdomadaire (W1 - Elder)
RSI_LEN=14                    # Période RSI
RSI_OB=70                     # Surachat RSI
RSI_OS=30                     # Survante RSI
ADX_LEN=14                    # Période ADX
ADX_TREND=20                  # Seuil minimum de tendance ADX

# ======================
# PARAMÈTRES PAR CLASSE D'ACTIFS
# ======================
# Forex
SCORE_MIN_FOREX=6
EMA_FAST_FOREX=21
EMA_SLOW_FOREX=55
ADX_TREND_FOREX=20
SL_ATR_MULT_FOREX=1.5
TP_ATR_MULT_FOREX=3.0
FOREX_NEWS_AVOID_MINUTES=30   # Évitement des annonces macro (±30 min)

# ======================
# NOUVELLES, SENTIMENT & MACRO
# ======================
NEWS_ASSETS_MT5=EUR,USD,GBP,JPY,CAD,CHF,AUD,NZD
NEWS_UPDATE_INTERVAL=300
NEWS_AVOIDANCE_BEFORE=30      # Minutes avant annonce à fort impact
NEWS_AVOIDANCE_AFTER=15       # Minutes après annonce à fort impact
NEWS_RISK_REDUCTION_FACTOR=0.5
NEWS_HIGH_IMPACT_ONLY=false
FEAR_GREED_EXTREME_FEAR=20
FEAR_GREED_EXTREME_GREED=80

# ======================
# LOGGING & DASHBOARD
# ======================
LOG_LEVEL=INFO
ENABLE_DASHBOARD=true
DASHBOARD_PORT=5000
# 127.0.0.1 = accessible uniquement depuis cette machine (recommandé : pas d'authentification)
DASHBOARD_HOST=0.0.0.0

# ======================
# TÉLÉMÉTRIE (OPTIONNEL)
# ======================
NEXQUANT_API_URL=http://localhost:8080
NEXQUANT_USER_ID=
NEXQUANT_INGEST_TOKEN=

# ======================
# TSMOM (Macro Momentum)
# ======================
TSMOM_ENABLED=true
TSMOM_PLACE_ORDERS=true
TSMOM_TARGET_VOL=0.12
TSMOM_MAX_LEVERAGE=1.5
TSMOM_LOOKBACK=3
TSMOM_SKIP=1
